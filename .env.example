# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=energy
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=energy
# Host used by scripts running on your machine. Containers override this with "postgres".
POSTGRES_HOST=localhost
# Host port published by docker compose (5440 avoids clashing with a local PostgreSQL on 5432).
POSTGRES_PORT=5440

# --- Pipeline ---
LOG_LEVEL=INFO
RANDOM_SEED=42

# --- Models ---
# OpenMP threads per XGBoost/LightGBM model (higher values can be much slower on a busy machine)
MODEL_N_JOBS=4

# --- MLflow ---
MLFLOW_PORT=5000
# Scripts on the host log here; containers use http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5000

# --- Services (host ports) ---
API_PORT=8000
FRONTEND_PORT=3001
API_CORS_ORIGINS=*
