# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL ---
POSTGRES_USER=energy
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=energy
# Host used by scripts running on your machine. Containers override this with "postgres".
POSTGRES_HOST=localhost
# Host port published by docker compose (5440 avoids clashing with a local PostgreSQL on 5432).
POSTGRES_PORT=5440

# --- Pipeline ---
LOG_LEVEL=INFO
RANDOM_SEED=42
